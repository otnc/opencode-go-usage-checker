# Copy this file to .env and fill in the real value. .env itself is gitignored.
#
# Azure DevOps PAT with the Marketplace > Manage scope, from
# https://marketplace.visualstudio.com/manage
#
# Only `npm run publish` reads this. The release workflow takes the token from
# the VSCE_PAT repository secret instead, and never looks at this file.
VSCE_PAT=
